# 管理员令牌：写操作必需（缺省则写接口 503）
VG_ADMIN_TOKEN=change-me

# 大模型：VG 只接商用 API，未配置即报错（无降级）
VG_LLM_PROVIDER=deepseek
VG_LLM_API_KEY=
# 可选：覆盖默认端点/模型
# VG_LLM_BASE_URL=https://api.deepseek.com/v1
# VG_LLM_MODEL=deepseek-v4.1-flash
# VG_LLM_TIMEOUT_MS=60000

# 实例标识（写入 forkOrigin，便于跨实例追溯）
VG_INSTANCE_NAME=local

# 访客提案：1=开放（默认），0=关闭
VG_PUBLIC_SUBMIT=1
# 邮件里的站内链接前缀（部署到域名后请改）
VG_PUBLIC_BASE_URL=http://127.0.0.1:5277

# 提案审核结果邮件（确认/拒绝都发）
# resend：需要 API key + 发件人
VG_EMAIL_PROVIDER=resend
VG_EMAIL_API_KEY=
VG_EMAIL_FROM=no-reply@example.com
# webhook：把 {to,subject,text} POST 到你的邮件网关（二选一）
# VG_EMAIL_PROVIDER=webhook
# VG_EMAIL_WEBHOOK_URL=
# VG_EMAIL_WEBHOOK_TOKEN=
# 开发环境：只在服务端 stdout 打印
# VG_EMAIL_PROVIDER=console

# 端口（宿主机映射）
VG_PORT=5277

# 可选：进程内每周定时（留空关闭）
# VG_WEEKLY_DAY=1
# VG_WEEKLY_AT=09:00