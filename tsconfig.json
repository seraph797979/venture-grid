{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": [
    "domain/**/*.ts",
    "db/**/*.ts",
    "services/**/*.ts",
    "llm/**/*.ts",
    "agent/**/*.ts",
    "api/**/*.ts",
    "serve.ts",
    "run.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "ui", "data"]
}